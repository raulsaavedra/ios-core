{
  "name": "@raulsaavedra/ios-core",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.9",
  "bin": {
    "ios-core": "./src/cli.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "check": "bun run format:check && bun run typecheck && bun test",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.1",
    "@types/bun": "^1.3.9",
    "typescript": "~6.0.2"
  }
}
